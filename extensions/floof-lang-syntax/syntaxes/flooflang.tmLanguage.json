{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FloofLang",
  "scopeName": "source.flooflang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#function-declaration" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.flooflang",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.flooflang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.flooflang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.flooflang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.flooflang",
          "begin": "@",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.attribute.flooflang" }
          },
          "end": "$",
          "patterns": [
            {
              "name": "entity.other.attribute-name.flooflang",
              "match": "[a-zA-Z_][a-zA-Z0-9_]*"
            },
            {
              "name": "punctuation.separator.comma.flooflang",
              "match": ","
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flooflang",
          "match": "\\b(if|else|while|for|match|break|continue|return|do|end)\\b"
        },
        {
          "name": "keyword.other.flooflang",
          "match": "\\b(using|require|pub|proc|struct|enum|const|extern|packed|typename)\\b"
        },
        {
          "name": "constant.language.boolean.flooflang",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.flooflang",
          "match": "\\b(u0|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|usize)\\b"
        },
        {
          "name": "entity.name.type.flooflang",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b(?!\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.flooflang",
          "match": "\\b0[xX][0-9a-fA-F]+([uUlL]+)?\\b"
        },
        {
          "name": "constant.numeric.float.flooflang",
          "match": "\\b-?[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?[fF]?\\b"
        },
        {
          "name": "constant.numeric.float.flooflang",
          "match": "\\b-?[0-9]+[eE][+-]?[0-9]+[fF]?\\b"
        },
        {
          "name": "constant.numeric.integer.flooflang",
          "match": "\\b-?[0-9]+([uUlL]+)?\\b"
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "match": "\\b(proc)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(<)([^>]*)(>)?\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.other.flooflang" },
            "2": { "name": "entity.name.function.flooflang" },
            "3": { "name": "punctuation.definition.generic.begin.flooflang" },
            "4": {
              "patterns": [
                { "match": "\\b[A-Z][a-zA-Z0-9_]*\\b", "name": "entity.name.type.flooflang" },
                { "match": "\\b(u0|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|usize)\\b", "name": "storage.type.primitive.flooflang" },
                { "match": ",", "name": "punctuation.separator.comma.flooflang" }
              ]
            },
            "5": { "name": "punctuation.definition.generic.end.flooflang" }
          }
        },
        {
          "match": "\\b(proc)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.other.flooflang" },
            "2": { "name": "entity.name.function.flooflang" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(<)([^>]*)(>)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.flooflang" },
            "2": { "name": "punctuation.definition.generic.begin.flooflang" },
            "3": {
              "patterns": [
                { "match": "\\b[A-Z][a-zA-Z0-9_]*\\b", "name": "entity.name.type.flooflang" },
                { "match": "\\b(u0|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|usize)\\b", "name": "storage.type.primitive.flooflang" },
                { "match": ",", "name": "punctuation.separator.comma.flooflang" }
              ]
            },
            "4": { "name": "punctuation.definition.generic.end.flooflang" }
          }
        },
        {
          "name": "entity.name.function.call.flooflang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.flooflang",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.pointer.flooflang",
          "match": "\\*|&"
        },
        {
          "name": "keyword.operator.arrow.flooflang",
          "match": "->"
        },
        {
          "name": "keyword.operator.arithmetic.flooflang",
          "match": "\\+|-|/|%"
        },
        {
          "name": "keyword.operator.comparison.flooflang",
          "match": "==|!=|<=?|>=?"
        },
        {
          "name": "keyword.operator.logical.flooflang",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.flooflang",
          "match": "<<|>>|\\||\\^|~"
        }
      ]
    }
  }
}